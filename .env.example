# =========================================================
# Mount Olivet Methodist Academy — Online Voting System
# Environment variables
# Copy this file to .env.local for local development, and
# add the same keys under Vercel Project Settings > Environment
# Variables for production/preview deployments.
# =========================================================

# --- Database (Neon Postgres) ---
# Get this from your Neon project dashboard -> Connection Details.
# Use the "pooled connection" string (it works fine with the
# @neondatabase/serverless HTTP driver used by this app).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/moma_evs?sslmode=require"

# --- Auth secrets ---
# Generate strong random values, e.g. `openssl rand -base64 48`
# Use a DIFFERENT value for each secret.
ADMIN_JWT_SECRET="change-this-to-a-long-random-string-for-admin-sessions"
STUDENT_JWT_SECRET="change-this-to-a-different-long-random-string-for-student-sessions"

# --- One-time setup route protection ---
# Used to protect /api/setup (creates the first admin account).
# Choose a random value, call the route once, then you can leave
# it set (the route is safe to call again — it no-ops if an
# admin already exists).
SETUP_SECRET="change-this-to-a-random-setup-key"

# --- Vercel Blob (candidate photo uploads) ---
# Automatically populated when you enable "Blob" storage on your
# Vercel project (Project -> Storage -> Create Database -> Blob).
# For local dev, run `vercel env pull .env.local` after enabling it,
# or paste the token here manually.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"
